# Subject: Use __uint128_t instead of 'unsigned __int128' in Divisor64
# Why: GCC -Wpedantic: ISO C++ does not support '__int128'.
#
diff --git a/hwy/base.h b/hwy/base.h
index 701d9e5..8a43f72 100644
--- a/hwy/base.h
+++ b/hwy/base.h
@@ -3046,7 +3046,7 @@ class Divisor64 {
     unsigned __int64 remainder;  // unused
     return _udiv128(hi, uint64_t{0}, div, &remainder);
 #else
-    using u128 = unsigned __int128;
+    using u128 = __uint128_t;  // R package highway (patch 0005): -Wpedantic
     const u128 hi128 = static_cast<u128>(hi) << 64;
     return static_cast<uint64_t>(hi128 / static_cast<u128>(div));
 #endif
@@ -3056,7 +3056,7 @@ class Divisor64 {
 #if HWY_COMPILER_MSVC >= 1920 && HWY_ARCH_X86_64
     return __umulh(a, b);
 #else
-    using u128 = unsigned __int128;
+    using u128 = __uint128_t;  // R package highway (patch 0005): -Wpedantic
     const u128 a128 = static_cast<u128>(a);
     const u128 b128 = static_cast<u128>(b);
     return static_cast<uint64_t>((a128 * b128) >> 64);
